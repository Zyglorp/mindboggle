# Normalize line endings: store LF in the repo for all detected text files.
* text=auto

# Force LF on checkout for code and config (avoids CRLF creeping in on Windows).
*.py    text eol=lf
*.pyi   text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.rst   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.xml   text eol=lf

# The extension-less pipeline entry scripts are Python and need LF for the
# shebang. Matched by basename so this survives a move (e.g. into src/).
mindboggle     text eol=lf
mindboggle123  text eol=lf

# Binary assets: never normalize.
*.nii.gz  binary
*.gz      binary
*.zip     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.ico     binary
